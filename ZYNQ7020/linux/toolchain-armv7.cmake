set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SCOPE_TOOLCHAIN_PREFIX SCOPE_SYSROOT SCOPE_TARGET_PREFIX_PATH)
if(NOT DEFINED SCOPE_TOOLCHAIN_PREFIX)
    set(SCOPE_TOOLCHAIN_PREFIX "$ENV{SCOPE_TOOLCHAIN_PREFIX}")
endif()
if(NOT SCOPE_TOOLCHAIN_PREFIX)
    message(FATAL_ERROR "Set SCOPE_TOOLCHAIN_PREFIX to the full arm-linux-gnueabihf- prefix")
endif()
set(CMAKE_C_COMPILER "${SCOPE_TOOLCHAIN_PREFIX}gcc")
if(CMAKE_HOST_WIN32)
    string(APPEND CMAKE_C_COMPILER ".exe")
endif()
if(NOT DEFINED SCOPE_SYSROOT)
    execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot
        OUTPUT_VARIABLE SCOPE_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE sysroot_result)
    if(NOT sysroot_result EQUAL 0)
        message(FATAL_ERROR "Unable to query the compiler sysroot")
    endif()
endif()
if(NOT IS_DIRECTORY "${SCOPE_SYSROOT}")
    message(FATAL_ERROR "Set SCOPE_SYSROOT to the target Linux sysroot")
endif()
set(CMAKE_SYSROOT "${SCOPE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${SCOPE_SYSROOT}" ${SCOPE_TARGET_PREFIX_PATH})
list(APPEND CMAKE_PREFIX_PATH ${SCOPE_TARGET_PREFIX_PATH})
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
