CONFIG_ARCH_ZYNQ=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_MODULES is not set
CONFIG_SMP=y
# Keep the CPU clock established by this board's FSBL (600 MHz).
# CONFIG_CPU_FREQ is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB=y
CONFIG_USB_HID=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_GENERIC=y
# This symbol selects the legacy USB_PHY core; DT binds the ULPI PHY, not nop.
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_PHY=y
CONFIG_USB_ULPI=y
CONFIG_USB_ULPI_VIEWPORT=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_SERIAL_XILINX_PS_UART=y
CONFIG_SERIAL_XILINX_PS_UART_CONSOLE=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
# Expose the fixed QSPI partitions without a duplicate master MTD device.
# CONFIG_MTD_PARTITIONED_MASTER is not set
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI=y
CONFIG_SPI_CADENCE=y
CONFIG_SPI_ZYNQ_QSPI=y
CONFIG_PINCTRL_ZYNQ=y
CONFIG_GPIO_ZYNQ=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_JFFS2_FS=y
CONFIG_DMADEVICES=y
CONFIG_XILINX_DMA=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# CONFIG_DRM is not set
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_INPUT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# Keep FSBL's splash in the scanout buffer until the GUI paints its first frame.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set
# CONFIG_MODULE_SIG is not set
# Board bring-up uses PS USB Host, SD, QSPI and the existing PL scanout.
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_PCI is not set
# CONFIG_NETDEVICES is not set
# CONFIG_CAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM_XLNX is not set
# CONFIG_USB_GADGET is not set
# CONFIG_MTD_RAW_NAND is not set
# CONFIG_MTD_CFI is not set
# CONFIG_REMOTEPROC is not set
