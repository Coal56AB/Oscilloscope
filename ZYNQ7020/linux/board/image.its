/dts-v1/;

/ {
    description = "Oscill Linux FIT";
    #address-cells = <1>;

    images {
        kernel {
            description = "Linux zImage";
            data = /incbin/("zImage");
            type = "kernel";
            arch = "arm";
            os = "linux";
            compression = "none";
            load = <0x03000000>;
            entry = <0x03000000>;
            hash-1 { algo = "sha256"; };
        };

        ramdisk {
            description = "BusyBox gzip initramfs";
            data = /incbin/("rootfs.cpio.gz");
            type = "ramdisk";
            arch = "arm";
            os = "linux";
            /* Linux decompresses the initramfs; U-Boot copies it as-is. */
            compression = "none";
            load = <0x08000000>;
            hash-1 { algo = "sha256"; };
        };

        fdt {
            description = "Oscill ZYNQ MINI rev B device tree";
            data = /incbin/("oscill-zynq7020.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
            load = <0x02000000>;
            hash-1 { algo = "sha256"; };
        };
    };

    configurations {
        default = "conf";
        conf {
            description = "XC7Z020 QSPI Linux";
            kernel = "kernel";
            ramdisk = "ramdisk";
            fdt = "fdt";
        };
    };
};
