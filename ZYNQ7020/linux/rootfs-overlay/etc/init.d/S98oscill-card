#!/bin/sh
set -eu
PIDFILE=/run/oscill-card.pid
case "${1:-start}" in
start)
    [ ! -f "$PIDFILE" ] || exit 0
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/sbin/oscill-card -- watch
    ;;
stop)
    start-stop-daemon -K -o -p "$PIDFILE" -x /bin/sh
    rm -f "$PIDFILE"
    ;;
restart) "$0" stop && "$0" start ;;
*) echo 'Usage: S98oscill-card start|stop|restart' >&2; exit 2 ;;
esac
